{
	// See https://go.microsoft.com/fwlink/?LinkId=733558
	// for the documentation about the tasks.json format
	"version": "2.0.0",
	"tasks": [
		{
			"label": "test GDScript",
			"type": "shell",
			"command": "/Applications/Redot_mono.app/Contents/MacOS/Redot --headless --path /Users/user/Documents/vamp-rd res://addons/gspec/runner.tscn",
			"problemMatcher": [],
			"group": {
				"kind": "test",
				"isDefault": true
			}
		},
		{
			"label": "lint GDScript",
			"type": "shell",
			"command": "python3 tools/lint/lint.py",
			"problemMatcher": {
				"owner": "gdscript-lint",
				"fileLocation": ["relative", "${workspaceFolder}"],
				"pattern": {
					"regexp": "^(.+?):(\\d+):(\\d+): ([\\w-]+): (.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"code": 4,
					"message": 5
				}
			}
		}
	]
}