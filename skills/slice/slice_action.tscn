[sub_resource type="Shader" id="Shader_trail_process"]
code = "shader_type particles;
render_mode keep_data, disable_force, disable_velocity;

uniform float half_width = 0.75;

void process() {
	float amount = LIFETIME;
	vec4 a = EMISSION_TRANSFORM * vec4(0.0, half_width, 0.0, 1.0);
	vec4 b = EMISSION_TRANSFORM * vec4(0.0, -half_width, 0.0, 1.0);

	if (CUSTOM.w == 0.0) {
		CUSTOM.w = float(INDEX) + 1.0;
		CUSTOM.z = amount;
		TRANSFORM = mat4(a, a, b, b);
	}

	if (CUSTOM.w == amount + 1.0) {
		CUSTOM.w = 1.0;
	}

	if (CUSTOM.w == 1.0) {
		TRANSFORM = mat4(a, a, b, b);
	}

	if (CUSTOM.w == 2.0) {
		if (distance(TRANSFORM[0].xyz, a.xyz) > 0.8) {
			TRANSFORM[0] = a;
			TRANSFORM[3] = b;
		}
		TRANSFORM[1] = a;
		TRANSFORM[2] = b;
	}

	CUSTOM.w += 1.0;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_trail_process"]
shader = SubResource("Shader_trail_process")
shader_parameter/half_width = 0.75

[sub_resource type="Shader" id="Shader_trail_draw"]
code = "shader_type spatial;
render_mode unshaded, world_vertex_coords, cull_disabled, blend_add;

uniform vec4 trail_color : source_color = vec4(0.82, 0.94, 1.0, 0.85);

void vertex() {
	vec3 a = mix(MODEL_MATRIX[1].xyz, MODEL_MATRIX[0].xyz, UV.x);
	vec3 b = mix(MODEL_MATRIX[2].xyz, MODEL_MATRIX[3].xyz, UV.x);
	VERTEX = mix(a, b, UV.y);
	UV.x = (UV.x + INSTANCE_CUSTOM.w - 3.0) / max(INSTANCE_CUSTOM.z - 2.0, 1.0);
}

void fragment() {
	if (UV.x <= 0.0 || UV.x >= 1.0) {
		discard;
	}
	float fade = clamp(1.0 - UV.x, 0.0, 1.0);
	ALBEDO = trail_color.rgb;
	ALPHA = fade * fade * trail_color.a;
}
"

