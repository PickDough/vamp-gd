; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="vamp-gd"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("26.3", "Redot")

[autoload]

PhantomCameraManager="*uid://duq6jhf6unyis"
AutoloadGame="*uid://psd8q0g118b3"
DeDraw="*res://addons/de_draw/autoload/dedraw_global.gd"

[debug]

gdscript/warnings/show_experimental_struct_warning=false
gdscript/warnings/show_experimental_trait_warning=false

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="vamp-gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/de_draw/plugin.cfg", "res://addons/gspec/plugin.cfg", "res://addons/phantom_camera/plugin.cfg")

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemies"
3d_physics/layer_4="player_attacks"
3d_physics/layer_5="pickups"

[navigation]

3d/default_cell_height=0.03

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

rendering_device/driver.windows="d3d12"
environment/defaults/default_environment="uid://bpjs1tktbr4dd"
