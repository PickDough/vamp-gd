; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="vamp-gd"
run/main_scene="uid://b1rtmxwie6nni"
config/features=PackedStringArray("4.7", "C#")

[autoload]

DeDraw="*uid://vr6fy6w0a8ym"
PhantomCameraManager="*uid://duq6jhf6unyis"
AutoloadGame="*uid://psd8q0g118b3"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="vamp-gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/de_draw/plugin.cfg", "res://addons/gdsharp_extensions/plugin.cfg", "res://addons/phantom_camera/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
environment/defaults/default_environment="uid://bpjs1tktbr4dd"
